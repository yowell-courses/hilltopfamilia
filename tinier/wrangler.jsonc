// tinier, the link shortener, as a Worker: the ciphertext and the daily counts in D1, swept hourly.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tinier",
  "main": "worker.ts",
  "compatibility_date": "2026-10-08",
  // Only on its own domain: no workers.dev copy once this is live.
  "workers_dev": false,
  "routes": [{ "pattern": "tinier.hilltopfamilia.org", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tinier",
      // Filled in by `npx wrangler d1 create tinier` on the account the site deploys from.
      "database_id": "a41212a0-ba9c-4384-9d17-29b682f28d87",
      // The tables, as wrangler's numbered migrations (NNNN_name.sql), applied by the deploy before this Worker ships.
      "migrations_dir": "migrations",
    },
  ],
  // The sites that may call the API, and the only places a short link may lead (tinier.ts SITE), comma-separated, the
  // first the site's own: hilltopfamilia.org and its mirror on GitHub Pages (docs/mirror.md). A copy of your own
  // names its own (docs/self-host.md).
  "vars": { "SITE": "https://hilltopfamilia.org" },
  // A hundred links a day from one address, counted in D1 under a keyed hash (tinier.ts); the key is the secret
  // BRAKE_KEY (`wrangler secret put BRAKE_KEY`), never here. Expired links, and the counts of days before
  // yesterday, go every hour; a read of an expired link removes it sooner.
  "triggers": { "crons": ["17 * * * *"] },
  // No logs: the server learns that a link was made, and keeps even that to itself.
  "observability": { "enabled": false },
}
